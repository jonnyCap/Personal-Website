{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "noEmit": true,
    "allowJs": true,
    "strict": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": "."
  },
  "include": [
    "js/**/*",
    "scripts/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
